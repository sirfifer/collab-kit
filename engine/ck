#!/bin/sh
# ck: the Collab Kit command. Finds a Python 3.11 or later and runs ck.py beside this file.
# Works with sh on macOS and Linux, and with Git Bash on Windows. Set COLLAB_KIT_PYTHON to choose.
here=$(cd "$(dirname "$0")" && pwd)
for py in "$COLLAB_KIT_PYTHON" python3 python3.14 python3.13 python3.12 python3.11 \
          /opt/homebrew/bin/python3 /usr/local/bin/python3 python "py -3"; do
  [ -n "$py" ] || continue
  if $py -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec $py "$here/ck.py" "$@"
  fi
done
echo "collab-kit: no Python 3.11 or later found (set COLLAB_KIT_PYTHON to one)" >&2
exit 127
